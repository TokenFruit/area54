# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/

# Build output
dist/
build/
.next/
out/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Claude Code overrides (settings.json IS committed — it is team policy)
.claude/settings.local.json

# OS
.DS_Store

# Pipeline telemetry — local, per-checkout
.claude/telemetry.jsonl

# Merge authorisations — written by tools/merge_gate.py on a pass, read by
# hooks/guard_bash.py to permit exactly one `gh pr merge`. Short-lived
# and machine-local by design. Committing one would put a merge permit in the
# repo and deploy it to every target, so it is never tracked.
.claude/merge-authorisation.json
